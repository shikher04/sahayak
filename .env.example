# ── LLM Provider ────────────────────────────────────────
# "groq" for cloud/production, "ollama" for local dev
LLM_PROVIDER=ollama

# ── Groq (recommended for production — free tier) ───────
GROQ_API_KEY=
# Get key at: https://console.groq.com → API Keys

# ── Anthropic (optional) ────────────────────────────────
ANTHROPIC_API_KEY=

# ── Pinecone ────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sahayak-schemes

# ── Cohere (reranking) ──────────────────────────────────
COHERE_API_KEY=

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sahayak:password@localhost:5432/sahayak
REDIS_URL=redis://localhost:6379

# ── NextAuth ────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-to-a-secure-random-string-32chars
NEXTAUTH_URL=http://localhost:3000

# ── DigiLocker OAuth ────────────────────────────────────
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# ── UIDAI (Aadhaar sandbox) ─────────────────────────────
UIDAI_AUA_CODE=
UIDAI_LICENSE_KEY=

# ── Internal API URL (used by Next.js server) ───────────
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://api:8000
